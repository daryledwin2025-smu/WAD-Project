<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Applications</title>
    <style>
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px; 
            font-size: 0.9em;
            display: inline-block;
        }
       
        .status-pending { background-color: #ffeeba; color: #856404; } 
        .status-approved { background-color: #d4edda; color: #155724; } 
        .status-rejected { background-color: #f8d7da; color: #721c24; } 
        .status-draft { background-color: #e2e3e5; color: #383d41; } 
    </style>
</head>
<body>
    <header></header>

    <main>
        <a href="/home">Home</a>
        <h1>My Adoption Applications</h1>

        <% if (applications.length === 0) { %>
            <p>You haven't started any applications yet.</p>
            <a href="/browse">Find a pet to adopt</a>
        <% } else { %>
            <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; text-align: left;">
                <thead>
                    <tr style="background-color: #f2f2f2;">
                        <th>Pet Name</th>
                        <th>Shelter Name</th>
                        <th>Status</th>
                        <th>Date Started</th>
                        <th>Actions</th>
                        <th>Review Shelter</th>
                    </tr>
                </thead>
                <tbody>
                    <% applications.forEach(function(app) { %>
                        <tr>
                            <td>
                                <% if (app.pet) { %>
                                     <%= app.pet.name %>
                                <% } else { %>
                                     <span style="color: #d9534f; font-style: italic;">
                                        <strong><%= app.petName %></strong> is no longer available. Contact <%= app.shelterName %> for more info.
                                     </span>
                                <% } %>
                            </td>
                            <td>
                                <%= app.shelterName %>
                            </td>
                            <td>
                                <span class="status-badge status-<%= app.status.toLowerCase() %>">
                                    <strong><%= app.status %></strong>
                                </span>
                            </td>
                            <td><%= app.applicationDate.toDateString() %></td>
                            <td>
                                <% if (app.status === 'Draft') { %>
                                    <a href="/applications/edit/<%= app._id %>">Edit Draft</a> | 
                                <% } %>

                                <form action="/applications/delete/<%= app._id %>" method="POST" style="display:inline;">
                                    <button type="submit" onclick="return confirm('Are you sure you want to withdraw and delete this application?');">
                                        Withdraw
                                    </button>
                                </form>
                            </td>
                            <td>
                                <% if (reviewMap[app._id.toString()] && !app.pet) { %>
                                Pet deleted. You may still delete your review.
                                <form action="/browse/reviews/<%= reviewMap[app._id.toString()]._id %>/delete" method="POST" style="display:inline;">
                                    <input type="hidden" name="shelterId" value="<%= app.shelterId %>">
                                    <button type="submit">Delete</button>
                                </form> 
                                <% } else if (reviewMap[app._id.toString()] && app.pet) { %> 
                                    <!-- if a review exists for this application (looked up by applicationId) and pet listing still available  -->
                                    You have already submitted a review for this application. <br> Make changes or delete it here! 
                                    <br><br>
                                    <a href="/browse/reviews/<%= reviewMap[app._id.toString()]._id %>/edit">Edit</a>
                                    <form action="/browse/reviews/<%= reviewMap[app._id.toString()]._id %>/delete" method="POST" style="display:inline;">
                                        <input type="hidden" name="shelterId" value="<%= app.shelterId %>">
                                        <button type="submit">Delete</button>
                                    </form>
                                <% } else if (!app.pet) { %>
                                    <span style="color: #d9534f; font-style: italic;">
                                        <strong>You cannot submit a review for a deleted pet listing.</strong>
                                     </span>
                                <% } else if (app.status === 'Draft') { %>
                                    You have yet to complete your application. <br> Complete it before leaving a review!
                                <% } else { %>
                                    You have not submitted a review for this application yet. <br> Leave a review here! <br>
                                    <a href="/browse/reviews/new?shelterId=<%= app.shelterId %>&shelterName=<%= app.shelterName %>&applicationId=<%= app._id %>">Submit Review</a>
                                <% } %>

                        </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } %>
    </main>
</body>
</html>