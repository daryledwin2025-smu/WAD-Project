<!DOCTYPE html>
<html>
<title>Approve/Reject Application</title>
<h1>Approve/Reject Application</h1>
<body>
<form method="post" action="/dashboard/updatedApplicationDetails">
    <% applications.forEach(application => { %>
        <p> Application ID: <%= application.id %> </p> <input type="hidden" name="applicationId" value="<%= application.id %>">
                <p> Applicant ID: <%= application.applicantName %> </p> <input type="hidden" name="applicantId" value="<%= application.applicant %>">
                    <p> Pet: <%= application.petName %> </p> <input type="hidden" name="petId" value="<%= application.pet %>">
                        <p> Living Situation: <%= application.livingSituation %> </p> <input type="hidden" name="living" value="<%= application.livingSituation %>">
                            <% if(application.experienceDetails.length==0){ %>
                                <p> Experience Details: Applicant has no experience details! </p>                              
                                <% }else{ %>
                                    <p> Experience Details: <%= application.experienceDetails %> </p> <input type="hidden" name="exp" value="<%= application.experienceDetails %>">
                                        <% } %>
                                        <p>Application Status: <%= application.status %> </p> 
                                            <p> Application DateTime: <%= application.applicationDate %> </p> <input type="hidden" name="appDT" value="<%= application.applicationDate %>">
                                            <input type="hidden" name="shelterId" value="<%= application.shelterId %>">
                                            <input type="hidden" name="appName" value="<%= application.applicantName %>">
                                            <input type="hidden" name="petName" value="<% application.petName %>">
                                            
                                            <input type="radio" name="descision" value="Approved">Accept Application
                                            <input type="radio" name="descision" value="Rejected">Reject Application<br><br>
                                            <textarea name="comment" placeholder="Comments" rows="4" cols="50"></textarea><br><br>
                                            <button type="submit" name="submit">submit</button>
                                            </form>
                                                <hr>
    <% }) %>

</body>

</html>