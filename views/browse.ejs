<!DOCTYPE html>
<html>

<head>
    <title>Pets</title>
    <style>
        table {
            border-collapse: collapse;
            width: 80%;
            margin: 20px auto;
        }

        th,
        td {
            border: 1px solid black;
            padding: 10px;
            text-align: left;
            word-wrap: break-word;
            max-width: 300px;
            /* adjust this */
        }

        th {
            background-color: #f2f2f2;
        }
    </style>
</head>

<body>
    <a href="/home">Back to shelters</a>
    <h2 style="text-align:center;">
        <%=allPets.length%> Pets Available In <%=shelter.shelterName%>!
    </h2>
<% if (allPets.length > 0) { %>
    <h3 style="width:80%; margin:auto; margin-top:20px;">
        🔥 Top 3 Trending Pets (Based On Current Filter)
    </h3>

    <div style="width:80%; margin:auto; display:flex; gap:15px; margin-bottom:20px;">
        <% popularPets.forEach(pet => { %>
            <a href="#pet-<%= pet._id %>" style="text-decoration:none; color:black;">
                <div style="border:1px solid #ccc; padding:10px; border-radius:8px; width:150px;">
                    <strong>
                        <%= pet.name %>
                    </strong><br>
                    <small>👀 <%= pet.viewCount %> <%= pet.viewCount === 1 ? "viewer" : "viewers" %></small>
                                </div>
                                </a>
                                <% }) %>
                                    </div>
                                    <% } %>
    <form method="GET" action="/browse" style="width:80%; margin:auto; margin-bottom:20px;">
<a href="/browse?shelterId=<%= shelterId %>&sort=views&name=<%= req.query.name || '' %>&breed=<%= req.query.breed || '' %>&size=<%= req.query.size || '' %><%= req.query.vaccinated ? '&vaccinated=true' : '' %><%= req.query.neutered ? '&neutered=true' : '' %><%= req.query.houseTrained ? '&houseTrained=true' : '' %>">Sort by Views</a>        <input type="hidden" name="shelterId" value="<%= shelterId %>">
        <!-- Name -->
        <input type="text" name="name" placeholder="Search pet name" value="<%= req.query.name || '' %>">
<input type="text" name="breed" list="breedList" placeholder="Search breed" value="<%= req.query.breed || '' %>">

<datalist id="breedList">
    <% breeds.forEach(breed => { %>
        <option value="<%= breed %>">
    <% }) %>
</datalist>
<select name="ageGroup">
  <option value="">All Ages</option>
  <option value="young" <%= req.query.ageGroup === "young" ? "selected" : "" %>>
    Young (0–2)
  </option>
  <option value="adult" <%= req.query.ageGroup === "adult" ? "selected" : "" %>>
    Adult (3–7)
  </option>
  <option value="senior" <%= req.query.ageGroup === "senior" ? "selected" : "" %>>
    Senior (8+)
  </option>
</select>
        <!-- Size -->
        <select name="size">
            <option value="">All Sizes</option>

            <option value="Small" <%=req.query.size==="Small" ? "selected" : "" %>>
                Small
            </option>

            <option value="Medium" <%=req.query.size==="Medium" ? "selected" : "" %>>
                Medium
            </option>

            <option value="Large" <%=req.query.size==="Large" ? "selected" : "" %>>
                Large
            </option>
        </select>

        <!-- Vaccinated -->
        <label>
            <input type="checkbox" name="vaccinated" <%=req.query.vaccinated ? "checked" : "" %>
            >
            Vaccinated
        </label>
        <!-- Neutered -->
        <label>
            <input type="checkbox" name="neutered" <%=req.query.neutered ? "checked" : "" %>
            >
            Neutered
        </label>

        <!-- House Trained -->
        <label>
            <input type="checkbox" name="houseTrained" <%=req.query.houseTrained ? "checked" : "" %>
            >
            House Trained
        </label>

        <!-- Submit -->
        <button type="submit">Filter</button>

        <!-- Reset -->
        <a href="/browse?shelterId=<%=shelterId%>" style="margin-left:10px;">Reset</a>

    </form>
    <%if(allPets.length==0){%>
        <h2 style="text-align:center">No Pets Available :( Sorry!</h2>
        <%} else{%>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Breed</th>
                        <th>Age</th>
                        <th>Description</th>
                        <th>Size</th>
                        <th>View More</th>
                        <% if (user && user.account !=="Shelter" ) { %>
                            <th>Favourite</th>
                            <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% allPets.forEach(pet=> { %>
                        <tr id="pet-<%= pet._id %>">
                            <td>
<%= pet.name %><br>
<small>
  👀 <%= pet.viewCount %> <%= pet.viewCount === 1 ? "viewer" : "viewers" %>
  <% if (pet.viewCount > 5) { %> · 🔥 Popular<% } %>
</small>                          
</td>
                            <td>
                                <%= pet.breed %>
                            </td>
                            <td>
                                <%= pet.age %>
                            </td>
                            <td>
                                <%= pet.description.slice(0,100) %>
                                    <%= pet.description.length> 50 ? "..." : "" %>
                            </td>
                            <td>
                                <%=pet.size%>
                            </td>
                            <td> <a href="/browse/petDetail?petId=<%=pet._id%>">View More</a> </td>
                            <% if (user && user.account !=="Shelter" ) { %>
                                <td>
                                    <% if (favouritedPetIds.includes(pet._id.toString())) { %>
                                        <span>❤️ Favourited</span>
                                    <% } else { %>
                                        <form action="/favourites/add" method="POST" style="display:inline;">
                                            <input type="hidden" name="petId" value="<%= pet._id %>">
                                            <button type="submit">🤍 Favourite</button>
                                        </form>
                                    <% } %>
                                </td>
                                <% } %>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <%}%>
                <!-- DARRYL's SHELTER REVIEWS -->

                <hr>
                <h3>Shelter Ratings <%= avgRating ? '⭐ ' + avgRating + '/5.0' : '' %> (<%= reviews.length %>)
                </h3>

                <% if (reviews.length===0) { %>
                    <p>No reviews yet.</p>
                    <% } else { %>
                        <% reviews.forEach(review=> { %>
                            <% if (review.reviewer) { %> <!--if reviewer exists and not deleted, extra layer of check aside from validReviews -->
                                <p><strong>
                                        <%= review.reviewer.username %>
                                    </strong> — ⭐ <%= review.rating %>/5</p>
                                <p>
                                    <strong>Pet applied for: <%= review.applicationId ? review.applicationId.petName : '' %></strong>
                                </p>
                                <p>
                                    <%= review.comment %>
                                </p>
                               <p><small>Posted on: <%= new Date(review.createdAt).toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' }) %></small></p>
                                <% if (review.updatedAt) { %>
                                    <p><small>Updated on: <%= new Date(review.updatedAt).toLocaleString('en-SG', { dateStyle: 'medium', timeStyle: 'short' }) %></small></p>
                                <% } %>
                                        <% } %>
                                            <hr>
                                            <% }) %>
                                                <% } %>

                                                    <a href="/browse/reviews/all?shelterId=<%= shelterId %>">See all
                                                        reviews →</a>


</body>

</html>