<!DOCTYPE html>
<html>
<title>Shelter Dashboard</title>

<body>
    <h1 style="text-align: center;">Welcome to Shelter Dashboard</h1>
    <hr style="width: 15cm;">

    <h2>Descision Logs: </h2> <p><a href="/dashboard/descisionlogs">Descision Logs</a></p>
    <h2>Shelter Home: </h2><p><a href="/home-shelter">Home</a></p>
    <h2 >Pending Applications:</h2>
    <br>
    
    

    <% if(dashboardList.length == 0){ %>
        <p>You got no pending applications!</p> <% }else{ %>
        <% dashboardList.forEach(application=> { %>

            <p> Application ID: <%= application.id %> </p>
                <p> Applicant ID: <%= application.applicantName %> </p>
                    <p>
    Pet:
    <% if (application.pet) { %>
        <%= application.pet.name %>
    <% } else { %>
        <span style="color:red;">Pet Listing Deleted</span>
        <br>
        <small>(Original: <%= application.petName %>)</small>
    <% } %>
</p>
                        <p> Living Situation: <%= application.livingSituation %> </p>
                            <% if(application.experienceDetails.length==0){ %>
                                <p> Experience Details: Applicant has no experience details! </p>                             
                                <% }else{ %>
                                    <p> Experience Details: <%= application.experienceDetails %> </p>
                                        <% } %>
                                        <p>
    Application Status:
    <% if (application.pet) { %>
        <a href="/dashboard/applicationDetails/<%= application.id %>">
            <%= application.status %>
        </a>
    <% } else { %>
        <span style="color:gray;">
            <%= application.status %> (Listing Deleted)
        </span>
    <% } %>
</p>
                                            <p> Application DateTime: <%= application.applicationDate %> </p>
                                                <hr>
                                                <% }); %>
                                            <% } %>
</body>

</html>