<!DOCTYPE html>
<html>
<title>Shelter Dashboard</title>
<body>
    <h1 style="color: chartreuse;">Welcome to the Dashboard</h1>
    <hr>
    <table border="0">
        <tr>
            <th>
                <h2 style="color: tomato;">Applications</h2>
            </th>
        </tr>
        <% dashboardList.forEach(application=> { %>
            <tr>
                <td>
                    <%= application %>
                </td>
            </tr>
            <% }); %>
    </table>
</body>

</html>