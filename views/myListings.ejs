<head>
    <title>Pets</title>
    <style>
        table {
            border-collapse: collapse;
            width: 80%;
            margin: 20px auto;
        }

        th,
        td {
            border: 1px solid black;
            padding: 10px;
            text-align: left;
            word-wrap: break-word;
            max-width: 300px;
            /* adjust this */
        }

        th {
            background-color: #f2f2f2;
        }
    </style>
</head>

<body>

    <h2 style="text-align:center;">My Listings</h2>
    <div style="width:80%; margin: auto; text-align: right;">
        <a href="/pets/addPet">+ Add New Pet</a>
    </div>
    <div style="width:80%; margin: auto; text-align: left;">
        <a href="/home-shelter">Back To Home</a>
    </div>

    <h2 style="text-align:center">You Have <%=allPets.length%> Pets Listed!</h2>

    <p style="text-align:center;">
        💉 Vaccinated &nbsp;&nbsp;
        ✂️ Neutered &nbsp;&nbsp;
        🏠 House Trained
    </p>

    <form method="GET" action="/pets/myListings" style="width:80%; margin:auto; margin-bottom:20px;">
<a href="/pets/myListings?sort=views&name=<%= req.query.name || '' %>&breed=<%= req.query.breed || '' %>&size=<%= req.query.size || '' %><%= req.query.vaccinated ? '&vaccinated=true' : '' %><%= req.query.neutered ? '&neutered=true' : '' %><%= req.query.houseTrained ? '&houseTrained=true' : '' %>">
  Sort by Views
</a>
        <!-- Name -->
        <input type="text" name="name" placeholder="Exact name" value="<%= req.query.name || '' %>">
<!-- Breed -->
<input type="text" name="breed" list="breedList" placeholder="Search breed" value="<%= req.query.breed || '' %>">

<datalist id="breedList">
    <% breeds.forEach(breed => { %>
        <option value="<%= breed %>">
    <% }) %>
</datalist>
<select name="ageGroup">
  <option value="">All Ages</option>
  <option value="young" <%= req.query.ageGroup === "young" ? "selected" : "" %>>
    Young (0–2)
  </option>
  <option value="adult" <%= req.query.ageGroup === "adult" ? "selected" : "" %>>
    Adult (3–7)
  </option>
  <option value="senior" <%= req.query.ageGroup === "senior" ? "selected" : "" %>>
    Senior (8+)
  </option>
</select>
        <!-- Size -->
        <select name="size">
            <option value="">All Sizes</option>

            <option value="Small" <%=req.query.size==="Small" ? "selected" : "" %>>
                Small
            </option>

            <option value="Medium" <%=req.query.size==="Medium" ? "selected" : "" %>>
                Medium
            </option>

            <option value="Large" <%=req.query.size==="Large" ? "selected" : "" %>>
                Large
            </option>
        </select>

        <!-- Vaccinated -->
        <label>
            <input type="checkbox" name="vaccinated" <%=req.query.vaccinated ? "checked" : "" %>
            >
            Vaccinated
        </label>
        <!-- Neutered -->
        <label>
            <input type="checkbox" name="neutered" <%=req.query.neutered ? "checked" : "" %>
            >
            Neutered
        </label>

        <!-- House Trained -->
        <label>
            <input type="checkbox" name="houseTrained" <%=req.query.houseTrained ? "checked" : "" %>
            >
            House Trained
        </label>

        <!-- Submit -->
        <button type="submit">Filter</button>

        <!-- Reset -->
        <a href="/pets/myListings" style="margin-left:10px;">Reset</a>
    </form>
    <%if(allPets.length==0){%>
        <h2 style="text-align:center"> Nothing here yet! Go ahead and add your first pet 🐶</h2>
        <%} else{%>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Breed</th>
                        <th>Age</th>
                        <th>Description</th>
                        <th>Size</th>
                        <th>More Information</th>
                        <th>Manage Pet</th>
                        <th>Delete Pet Listing</th>


                    </tr>
                </thead>
                <tbody>
                    <% allPets.forEach(pet=> { %>
                        <tr>
                            <td>
                                <%= pet.name %> <br>👀<%=pet.viewCount%> <br> <% if (pet.viewCount > 3) { %>🔥 Popular<% } %>
                            </td>
                            <td>
                                <%= pet.breed %>
                            </td>
                            <td>
                                <%= pet.age %>
                            </td>
                            <td>
                                <%= pet.description %>
                            </td>
                            <td>
                                <%=pet.size%>
                            </td>
                            <td>
                                💉: <%= pet.vaccinated ? "✅" : "❌" %><br>
                                    ✂️: <%= pet.neutered ? "✅" : "❌" %><br>
                                        🏠: <%= pet.houseTrained ? "✅" : "❌" %>
                            </td>
                            <td>
                                <a href="/pets/editPet?petId=<%= pet._id %>">Manage Pet</a>
                            </td>
                            <td>
                                <a href="/pets/deletePet?petId=<%=pet._id%>"
                                    onclick="return confirm('Are you sure you want to delete <%=pet.name%>?')">🗑️</a>
                            </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<%}%>
</body>
