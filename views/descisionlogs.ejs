<!DOCTYPE html>
<html>
    <title>Descision Logs</title>
    <h1>Descision Logs</h1>
    <p><a href="/dashbaord">Back to Dashboard</a></p><br>
    <body>
        <% descisionlogs.forEach(descisionLog => { %>
        <p>Applicant ID: <%= descisionLog.applicant %> </p>
        <p>Pet: <%= descisionLog.pet %></p>
        <% if(descisionLog.experienceDetails.length==0){ %>
                                <p> Experience Details: Applicant has no experience details! </p>                             
                                <% }else{ %>
                                    <p> Experience Details: <%= descisionLog.experienceDetails %> </p>
                                        <% } %>
        <p>Status: <%= descisionLog.status %></p>
        <p>Application Date: <%= descisionLog.applicationDate %></p>
        <p>Comments: <%= descisionLog.comments %></p>
        <p>Descision DateTime: <%= descisionLog.descisionDateTime %></p>
        <hr>
            <% }) %>
    </body>
</html>