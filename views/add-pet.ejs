<!DOCTYPE html>
<html>
<head>
    <title>Add Pet</title>
</head>
<body>

    <h1>Add New Pet ✚</h1>
<h2>Pet Details 🐶</h2>

    <form action="/pets/addPet" method="POST">

        <div>
            <label>Name:</label>
            <input type="text" name="name" value="<%= pet?.name || '' %>" required>
        </div>
<br>
        <div>
            <label>Breed:</label>
            <input type="text" name="breed" value="<%= pet?.breed || '' %>" required>
        </div>
<br>

        <div>
            <label>Age:</label>
            <input type="number" name="age" value="<%= pet?.age || '' %>" required>
        </div>
<br>
Dog size:
<select name="size" required>
  <option value="">Select size</option>
  <option value="Small" <%= pet?.size === "Small" ? "selected" : "" %>>Small 🟢</option>
  <option value="Medium" <%= pet?.size === "Medium" ? "selected" : "" %>>Medium 🟠</option>
  <option value="Large" <%= pet?.size === "Large" ? "selected" : "" %>>Large 🔴</option>
</select>

<br><br>

<label>Description:</label><br><small style="color:gray;">Maximum 200 characters</small><br>
<textarea name="description" rows="4" cols="40"><%= pet?.description || '' %></textarea>
<% if (error) { %>
    <p style="color:red;"><%= error %></p>
<% } %>
<br>

<h2>Other Information 📊</h2>

<label>
  <input type="checkbox" name="vaccinated" <%= pet?.vaccinated ? "checked" : "" %>>
  Vaccinated
</label><br>

<label>
  <input type="checkbox" name="neutered" <%= pet?.neutered ? "checked" : "" %>>
  Neutered
</label><br>

<label>
  <input type="checkbox" name="houseTrained" <%= pet?.houseTrained ? "checked" : "" %>>
  House Trained
</label><br>
<br>

        <button type="submit">Add Pet</button>

    </form>

    <br>

    <a href="/pets/myListings">Back to My Listings</a>

</body>
</html>