<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
</head>

<body>
    <h1>Register</h1>
    <form method="post" action="/user-login">
        <label for="account">Account:</label>
        <select id="account" name="account">
            <option value="" selected></option>
            <option value="Adopter">Adopter</option>
            <option value="Shelter">Shelter</option>
        </select><br><br>

        Username : <br>
        <input type="text" name="username">
        <br><br>

        Password : <br>
        <input type="password" name="pass">
        <br><br>

        Confirm Password : <br>
        <input type="password" name="confirmPass" required>
        <br><br>

        Email : <br>
        <input type="email" name="email">
        <br><br>

        Phone : <br>
        <input type="text" name="phone">
        <br><br>

        Gender:
        <input type="radio" id="male" name="gender" value="male">
        <label for="male">Male</label>
        <input type="radio" id="female" name="gender" value="female">
        <label for="female">Female</label><br><br>

        <!-- Access Code : <br>
                <input type="code" name="code">
                <br><br> -->


        <div id="shelterFields" style="display: none;">
            Shelter Name : <br>
            <input type="text" name="shelterName">
            <br><br>

            Shelter Email : <br>
            <input type="text" name="shelterEmail">
            <br><br>

            Contact Number : <br>
            <input type="text" name="shelterNumber">
            <br><br>

            Shelter Address : <br>
            <input type="text" name="shelterAddress">
            <br><br>

        </div>
        <button type="button" onclick="location.href='/'">
            Back</button> &nbsp;&nbsp;
        <button type="submit">Register</button>
    </form>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <script>
        alert("<%= errorMessage %>");
    </script>
<% } %>

</body>

</html>

<script>
    const account = document.getElementById("account");
    const shelterFields = document.getElementById("shelterFields");

    account.addEventListener("change", function () {
        if (account.value === "Shelter") {
            shelterFields.style.display = "block";
        } else {
            shelterFields.style.display = "none";
        }
    });
</script>
