<!DOCTYPE html>
<html>
<head>
    <title>Manage Pet</title>
</head>
<body>

    <h1>Manage Pet ✏️</h1>
<h2>Pet Details 🐶</h2>

    <form action="/pets/editPet" method="POST">

        <div>
            <label>Name:</label>
            <input type="text" name="name" value="<%= pet.name %>" required>
        </div>
<br>

        <div>
            <label>Breed:</label>
            <input type="text" name="breed" value="<%= pet.breed %>" required>
        </div>
<br>

        <div>
            <label>Age:</label>
            <input type="number" name="age" value="<%= pet.age %>" required>
        </div>
<br>
Dog size:
<select name="size" required>
  <option value="">Select size</option>
  <option value="Small" <%= pet.size === "Small" ? "selected" : "" %>>Small</option>
  <option value="Medium" <%= pet.size === "Medium" ? "selected" : "" %>>Medium</option>
  <option value="Large" <%= pet.size === "Large" ? "selected" : "" %>>Large</option>
</select>
<br><br>
        <label>Description:</label><br><small style="color:gray;">Maximum 200 characters</small><br>
        
        <textarea name="description" rows="4" cols="40" required><%= pet.description %></textarea><% if (error) { %>
            
    <p style="color:red;"><%= error %></p>
<% } %>
<br>
<h2>Other Information 📊</h2>

<label>
  <input type="checkbox" name="vaccinated" <%= pet.vaccinated ? "checked" : "" %>>
  Vaccinated
</label><br>

<label>
  <input type="checkbox" name="neutered" <%= pet.neutered ? "checked" : "" %>>
  Neutered
</label><br>

<label>
  <input type="checkbox" name="houseTrained" <%= pet.houseTrained ? "checked" : "" %>>
  House Trained
</label><br><br>

        <!-- hidden field to keep petId -->
        <input type="hidden" name="_id" value="<%= pet._id %>">

        <button type="submit">Save Changes</button>
        <br><br>
<a href="/pets/deletePet?petId=<%=pet._id%>" onclick="return confirm('Are you sure you want to delete <%=pet.name%>?')"><button type="button">Delete</button></a>
    </form>

    <br>
    <h2>Viewers 👀</h2>
    <!-- SEARCH & SORT VIEWERS -->
<form method="GET" action="/pets/editPet" style="margin-bottom:10px;">
    <input type="hidden" name="petId" value="<%= pet._id %>">

    <input 
        type="text" 
        name="search" 
        placeholder="Search by username or email"
        value="<%= req.query.search || '' %>"
    >

    <!-- SORT DROPDOWN -->
    <select name="sort">
        <option value="">Sort by</option>
        <option value="highest" <%= req.query.sort === "highest" ? "selected" : "" %>>
            Highest Views
        </option>
        <option value="lowest" <%= req.query.sort === "lowest" ? "selected" : "" %>>
            Lowest Views
        </option>
    </select>

    <select name="status">
    <option value="">All Status</option>

    <option value="applied" <%= req.query.status === "applied" ? "selected" : "" %>>
        Applied
    </option>

    <option value="interested" <%= req.query.status === "interested" ? "selected" : "" %>>
        Highly Interested
    </option>

    <option value="browsing" <%= req.query.status === "browsing" ? "selected" : "" %>>
        Browsing
    </option>
</select>

    <button type="submit">Apply</button>
    <a href="/pets/editPet?petId=<%= pet._id %>">
    <button type="button">Reset</button>
</a>
</form>
<% if (viewers.length > 0) { %>
    <table border="1" cellpadding="5">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Viewed At</th>
                <th>View Count</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% viewers.forEach(v => { %>
                <tr>
                    <td><%= v.username %></td>
                    <td><%= v.email %></td>
                    <td><%= v.viewedAt.toDateString() %></td>
                    <td><%= v.viewCount %></td>
                    <td>
  <% if (v.hasApplied) { %>
    ✅ Applied
  <% } else if (v.viewCount >= 5) { %>
    🔥 Highly Interested
  <% } else { %>
    👀 Browsing
  <% } %>
</td>

                </tr>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <p>No one has viewed this pet yet.</p>
<% } %>

    <a href="/pets/myListings">Back to My Listings</a>

</body>
</html>