exports.deleteAccount = async (req, res) => {
  try {
    
    const user = req.session.user;
    // daryl edwin delete all pets of the user before deleting the account 
    await Pet.deletePetsByShelterId(user._id);
    await User.deleteUserByUsername(user.username);

    req.session.destroy((err) => {
      if (err) {
        return res.render('error', { error: err });
      }
      res.redirect('/');
    });
  } catch (error) {
    console.log(error);
    res.render('error', { error });
  }
};

exports.submitLogout = (req, res) => {
  // destroy function has async behavior!!!
  req.session.destroy(() => {
    return res.redirect('/');
  });
}

exports.submitEditProfile = async (req, res) => {
  try {
    const userId = req.session.user._id;
    const newUsername = req.body.username;

    const existingUser = await User.getUserByUsername(newUsername);

    if (existingUser && existingUser._id.toString() !== userId.toString()) {
      return res.render('user-edit', {
        user: req.session.user,
        errorMessage: 'Username already exists',
        successMessage: null
      });
    }

    const updatedData = {
      username: req.body.username,
      email: req.body.email,
      phone: req.body.phone,
      gender: req.body.gender
    };

    const updatedUser = await User.updateUserById(userId, updatedData);

    req.session.user = updatedUser;

    return res.render('user-edit', {
      user: updatedUser,
      errorMessage: null,
      successMessage: 'Profile updated successfully'
    });
  } catch (error) {
    console.log(error);
    return res.render('error', { error });
  }
};

exports.changePassword = async (req, res) => {
  try {
    const userId = req.session.user._id;
    const { currentPass, newPass, confirmNewPass } = req.body;

    const user = await User.getUserById(userId);

    if (!user) {
      return res.redirect("/");
    }

    const match = await bcrypt.compare(currentPass, user.pass);

    if (!match) {
      return res.render("user-edit", {
        user,
        errorMessage: "Current password is wrong",
        successMessage: null
      });
    }

    if (newPass !== confirmNewPass) {
      return res.render("user-edit", {
        user,
        errorMessage: "New passwords do not match",
        successMessage: null
      });
    }

    const hashedPassword = await bcrypt.hash(newPass, 10);
    const updatedUser = await User.updatePasswordById(userId, hashedPassword);

    req.session.user = updatedUser;

    return res.render("user-edit", {
      user: updatedUser,
      errorMessage: null,
      successMessage: "Password changed successfully"
    });
  } catch (error) {
    console.log(error);
    return res.render("user-edit", {
      user: req.session.user,
      errorMessage: "Unable to change password",
      successMessage: null
    });
  }
};