exports.submitLogout = (req, res) => {
  // destroy function has async behavior!!!
  req.session.destroy(() => {
    return res.redirect('/?reason=inactive');
  });
}


exports.submitEditProfile = async (req, res) => {
  try {
    if (!req.session || !req.session.user) {
      return res.redirect('/user-login');
    }

    const userId = req.session.user._id;

    const updatedData = {
      username: req.body.username,
      email: req.body.email,
      phone: req.body.phone,
      gender: req.body.gender,
      account: req.body.account
    };

    if (req.body.account === "Shelter") {
      updatedData.shelterName = req.body.shelterName || null;
      updatedData.shelterEmail = req.body.shelterEmail || null;
      updatedData.shelterPhone = req.body.shelterPhone || null;
      updatedData.shelterAddress = req.body.shelterAddress || null;
    } else {
      updatedData.shelterName = null;
      updatedData.shelterEmail = null;
      updatedData.shelterPhone = null;
      updatedData.shelterAddress = null;
    }

    const updatedUser = await User.updateUserById(userId, updatedData);

    req.session.user = updatedUser;

    return res.redirect('/user-edit');
  } catch (error) {
    console.log(error);
    return res.render('error', { error });
  }
};